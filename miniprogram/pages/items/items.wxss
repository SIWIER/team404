/* pages/items/items.wxss — 物品管理页样式（风格对齐全局） */

/* 顶部 tab */
.tab-bar {
  display: flex; background: #fff; border-radius: 20rpx; margin: 0 24rpx 24rpx;
  padding: 10rpx; box-shadow: 0 8rpx 24rpx rgba(40, 60, 110, 0.08);
}
.tab {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: 16rpx;
  font-size: 30rpx; font-weight: 700; color: #7b8794;
}
.tab.on { background: linear-gradient(135deg, #3d7bfd, #6a5cff); color: #fff; }

.step-title { font-size: 30rpx; font-weight: 800; margin-bottom: 20rpx; }
.area-s { min-height: 120rpx; }

/* 提示条 */
.notice { background: #fff8ea; border: 1rpx solid #ffe0a8; }
.notice-t { font-weight: 800; color: #8a5b16; margin-bottom: 8rpx; }

/* 选图 */
.pick-box {
  border: 3rpx dashed #b9c8e8; border-radius: 20rpx; background: #fbfdff;
  padding: 56rpx 20rpx; text-align: center;
}
.pick-icon { font-size: 72rpx; }
.pick-main { font-weight: 800; font-size: 32rpx; margin-top: 12rpx; }
.pick-sub { color: #7b8794; font-size: 24rpx; margin-top: 8rpx; }
.preview-img { border-radius: 16rpx; width: 100%; margin-top: 4rpx; }
.note-box {
  background: #eaf7ed; border: 1rpx solid #b8e6c6; color: #1f7a4d;
  border-radius: 16rpx; padding: 18rpx 22rpx; font-size: 26rpx; margin-top: 16rpx; line-height: 1.6;
}
.recognizing, .searching { text-align: center; padding: 24rpx 0 8rpx; }
.recognizing .spin, .searching .spin { font-size: 48rpx; animation: spin-rotate 1s linear infinite; display: inline-block; }
@keyframes spin-rotate { to { transform: rotate(360deg); } }
.rec-main { font-weight: 700; color: #3d5b9e; font-size: 28rpx; margin-top: 8rpx; }

/* 位置选择 chips */
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  border: 2rpx solid #e3e9f2; background: #fff; border-radius: 999rpx;
  padding: 10rpx 24rpx; font-size: 26rpx; font-weight: 600; color: #1f2b3a;
}
.chip.sm { padding: 6rpx 18rpx; font-size: 24rpx; }
.chip.on { border-color: #3d7bfd; background: #e8f0ff; color: #3d7bfd; }
.chips.filter { margin-bottom: 20rpx; }
.link { color: #3d7bfd; font-weight: 700; }

/* 检索 */
.search-kinds { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.kind {
  flex: 1; text-align: center; border: 2rpx solid #e3e9f2; background: #fff;
  border-radius: 16rpx; padding: 16rpx 6rpx; font-size: 26rpx; font-weight: 700;
}
.kind.on { border-color: #3d7bfd; background: #e8f0ff; color: #3d7bfd; }
.kind.off { opacity: 0.45; }
.search-row { display: flex; gap: 12rpx; align-items: center; }
.search-row .input { flex: 1; }

/* 结果列表 */
.result-head { margin: 0 32rpx 4rpx; font-size: 24rpx; color: #7b8794; }
.result-list { margin: 0 24rpx; }
.result-item {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; border-radius: 20rpx; padding: 22rpx; margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(40, 60, 110, 0.08);
}
.thumb {
  width: 120rpx; height: 120rpx; border-radius: 14rpx; flex-shrink: 0;
  background: #eef1f6;
}
.thumb.noimg {
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; border: 1rpx dashed #c3cede;
}
.ri-main { flex: 1; min-width: 0; }
.ri-name { font-weight: 800; font-size: 30rpx; }
.ri-score { font-size: 22rpx; color: #22b07d; font-weight: 700; margin-left: 6rpx; }
.ri-desc { color: #7b8794; font-size: 24rpx; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ri-loc { font-size: 24rpx; color: #3d5b9e; margin-top: 8rpx; font-weight: 600; }
.ri-del { padding: 16rpx; font-size: 34rpx; opacity: 0.75; flex-shrink: 0; }

.save-row { margin: 8rpx 24rpx 40rpx; }
.privacy-note { text-align: center; color: #7b8794; font-size: 22rpx; margin: 24rpx 48rpx; }
