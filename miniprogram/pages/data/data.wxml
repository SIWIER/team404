<view class="page-title">📊 存放统计</view>
<view class="page-sub">你存了什么、放在哪、覆盖多少房间，一目了然</view>

<!-- 加载中 / 加载失败 -->
<view class="card" wx:if="{{loading}}">
  <view class="center" style="padding:60rpx 0;">
    <view style="font-size:80rpx;">📦</view>
    <view class="muted" style="margin-top:12rpx;">统计数据加载中…</view>
  </view>
</view>
<view class="card" wx:elif="{{error}}">
  <view class="center" style="padding:40rpx 0;">
    <view style="font-size:80rpx;">⚠️</view>
    <view class="muted" style="margin:16rpx 0;">{{error}}</view>
    <view class="btn sm" bindtap="retry">重新加载</view>
  </view>
</view>

<block wx:else>
  <!-- 顶部统计卡 -->
  <view class="stat-cards">
    <view class="stat-card"><view class="v">{{s.total}}</view><view class="k">物品总数</view></view>
    <view class="stat-card"><view class="v">{{s.withImage}}</view><view class="k">带照片</view></view>
    <view class="stat-card"><view class="v small">{{s.roomCoverage}}</view><view class="k">覆盖房间</view></view>
    <view class="stat-card"><view class="v">{{s.last30}}</view><view class="k">近 30 天新增</view></view>
  </view>

  <view class="card empty-card" wx:if="{{noItems}}">
    <view style="font-size:80rpx;text-align:center;">📦</view>
    <view class="empty" style="padding-top:8rpx;">还没有录入任何物品</view>
    <view class="btn sm" style="margin:16rpx auto 0;width:320rpx;" bindtap="goItems">📷 去录入第一件物品</view>
  </view>

  <block wx:else>
    <!-- 目录分布 -->
    <view class="card" wx:if="{{spaceChips.length}}">
      <view class="chart-title">🗂 目录分布（家 / 公司 / 宿舍…）</view>
      <view class="tag-list">
        <view class="tag" wx:for="{{spaceChips}}" wx:key="name">{{item.name}} · {{item.c}} 件</view>
      </view>
    </view>

    <!-- 房间分布 -->
    <view class="card" wx:if="{{roomBars.length}}">
      <view class="chart-title">🏠 房间分布</view>
      <view class="bar-row" wx:for="{{roomBars}}" wx:key="name">
        <view class="bar-name">{{item.name}}</view>
        <view class="bar-track"><view class="bar-fill" style="width:{{item.pct}}%;background:{{item.color}};"></view></view>
        <view class="bar-count">{{item.c}}</view>
      </view>
    </view>

    <!-- 收纳家具 Top -->
    <view class="card" wx:if="{{furnBars.length}}">
      <view class="chart-title">🧩 收纳家具 Top</view>
      <view class="bar-row" wx:for="{{furnBars}}" wx:key="name">
        <view class="bar-name">{{item.name}}</view>
        <view class="bar-track"><view class="bar-fill" style="width:{{item.pct}}%;background:{{item.color}};"></view></view>
        <view class="bar-count">{{item.c}}</view>
      </view>
    </view>

    <!-- 户型热力：房间物品数叠加到户型图 -->
    <view class="card" wx:if="{{heat.hasLayout || heat.list.length}}">
      <view class="chart-title">🔥 户型热力：各房间存放的物品数</view>
      <block wx:if="{{heat.hasLayout && heat.placed}}">
        <view class="heat-floor">
          <view class="heat-row" wx:for="{{heat.floorRows}}" wx:for-item="row" wx:key="index"
                style="grid-template-columns: repeat({{row.cols}}, 1fr);">
            <view class="heat-cell" wx:for="{{row.cells}}" wx:for-item="item" wx:key="index" style="background: {{item.bg}};">
              <block wx:if="{{!item.empty}}">
                <view class="tile-emoji">{{item.e}}</view>
                <view class="tile-name">{{item.n}}</view>
                <view class="tile-count {{item.dim ? 'zero' : ''}}">{{item.count}} 件</view>
              </block>
            </view>
          </view>
        </view>
        <view class="extra-wrap" wx:if="{{heat.extras.length}}">
          <view class="extra-title">不在户型中的房间（有存放记录，虚线补充展示）</view>
          <view class="extra-list">
            <view class="extra-tile" wx:for="{{heat.extras}}" wx:key="name">
              <view class="tile-emoji">{{item.e}}</view>
              <view class="tile-name">{{item.name}}</view>
              <view class="tile-count">{{item.count}} 件</view>
            </view>
          </view>
        </view>
      </block>
      <block wx:elif="{{heat.list.length}}">
        <view class="heat-list">
          <view class="heat-tile" wx:for="{{heat.list}}" wx:key="name" style="background: {{item.bg}};">
            <view class="tile-emoji">{{item.e}}</view>
            <view class="tile-name">{{item.name}}</view>
            <view class="tile-count">{{item.count}} 件</view>
          </view>
        </view>
      </block>
      <view class="hint">颜色越深代表该房间存放的物品越多；布局来自你的户型图，可在「户型图配置」页调整。</view>
    </view>

    <!-- 最近录入 -->
    <view class="card">
      <view class="chart-title">🕓 最近录入（点击跳户型图高亮房间）</view>
      <view class="rec-row" wx:for="{{recent}}" wx:key="id" data-room="{{item.room}}" bindtap="tapItem">
        <view class="rec-main">
          <view class="rec-time">🕓 {{item.time}}<text wx:if="{{item.hasImage}}"> 📷</text></view>
          <view class="rec-name">{{item.name}}</view>
          <view class="rec-loc">📍 {{item.locationFull}}</view>
        </view>
        <view class="rec-side">
          <view class="btn ghost sm" data-id="{{item.id}}" catchtap="deleteItem">删除</view>
        </view>
      </view>
      <view class="btn-row" style="justify-content:center;">
        <view class="btn ghost sm" bindtap="goItems">📷 录入新物品</view>
        <view class="btn ghost sm" bindtap="goLayout">🏠 户型图配置</view>
      </view>
    </view>
  </block>
</block>
