/* pages/data/data.wxss — 物品存放统计页样式（复用 app.wxss 的 card/btn/empty/hint/tag） */
.toolbar { display: flex; align-items: center; gap: 16rpx; margin: 0 32rpx 8rpx; }

/* 顶部统计卡（2×2） */
.stat-cards { display: flex; flex-wrap: wrap; gap: 20rpx; margin: 0 24rpx 8rpx; }
.stat-card {
  flex: 1 1 40%; min-width: 0; box-sizing: border-box; background: #fff;
  border-radius: 24rpx; padding: 30rpx 20rpx; text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(40, 60, 110, 0.1);
}
.stat-card .v { font-size: 52rpx; font-weight: 800; color: #3d7bfd; line-height: 1.2; }
.stat-card .v.small { font-size: 32rpx; }
.stat-card .k { color: #7b8794; font-size: 24rpx; margin-top: 10rpx; }

.chart-title { font-weight: 700; font-size: 30rpx; margin-bottom: 20rpx; }
.empty-card { text-align: center; }

/* 条形分布（房间 / 收纳家具） */
.bar-row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.bar-name { width: 140rpx; font-size: 26rpx; font-weight: 600; text-align: right; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.bar-track { flex: 1; height: 20rpx; border-radius: 999rpx; background: #eef1f6; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999rpx; min-width: 12rpx; }
.bar-count { width: 56rpx; text-align: right; font-size: 26rpx; font-weight: 700; color: #1f2b3a; }

/* 户型热力网格 */
.heat-floor { background: #fafcff; border: 1rpx dashed #d5ddeb; border-radius: 14rpx; padding: 12rpx; }
.heat-row { display: grid; gap: 10rpx; margin-bottom: 10rpx; }
.heat-row:last-child { margin-bottom: 0; }
.heat-cell {
  border-radius: 12rpx; min-height: 110rpx; padding: 12rpx 6rpx; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.tile-emoji { font-size: 34rpx; }
.tile-name { font-size: 20rpx; color: #1f2b3a; font-weight: 700; margin-top: 2rpx; }
.tile-count { font-size: 20rpx; color: #1f2b3a; font-weight: 600; margin-top: 2rpx; }
.tile-count.zero { color: #b8c2cf; }

/* 不在户型中的房间：虚线框补充展示 */
.extra-wrap { margin-top: 20rpx; }
.extra-title { font-size: 22rpx; color: #7b8794; margin-bottom: 12rpx; font-weight: 600; }
.extra-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.extra-tile {
  border: 2rpx dashed #9db9ff; background: rgba(61, 123, 253, 0.05); border-radius: 16rpx;
  padding: 16rpx 20rpx; display: flex; flex-direction: column; align-items: center;
}

/* 无坐标时按列表展示 */
.heat-list { display: flex; flex-wrap: wrap; gap: 16rpx; justify-content: center; }
.heat-tile {
  border-radius: 16rpx; padding: 20rpx 24rpx; min-width: 140rpx;
  display: flex; flex-direction: column; align-items: center;
}

/* 最近录入列表 */
.rec-row { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid #eef1f6; }
.rec-row:last-child { border-bottom: none; padding-bottom: 4rpx; }
.rec-main { flex: 1; min-width: 0; }
.rec-time { font-size: 22rpx; color: #b8c2cf; }
.rec-name { font-size: 30rpx; font-weight: 700; margin-top: 4rpx; }
.rec-loc { font-size: 24rpx; color: #3d5b9e; font-weight: 600; margin-top: 6rpx; word-break: break-all; }
.rec-side { flex: none; }
