.profile-head { display: flex; align-items: center; gap: 20rpx; }
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: linear-gradient(135deg, #3d7bfd, #6a5cff); color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 800; flex-shrink: 0;
}
.profile-main { flex: 1; }
.p-name { font-weight: 800; font-size: 32rpx; }
.divider { border-top: 1rpx solid #eef1f6; margin: 24rpx 0; }
.floor { margin-top: 12rpx; display: flex; flex-direction: column; gap: 4rpx; padding: 10rpx; background: #fafcff; border: 1rpx dashed #d5ddeb; border-radius: 14rpx; }
.floor-row { display: grid; gap: 4rpx; }
.floor-cell {
  border: 1rpx dashed #d5ddeb; border-radius: 8rpx; background: #fff;
  font-size: 24rpx; text-align: center; padding: 2rpx;
  min-height: 44rpx; display: flex; align-items: center; justify-content: center;
}
.floor-cell.empty { background: #f7f9fc; }
/* 走廊多格链：琥珀色虚线，与画像页编辑器一致，凸显连通走廊 */
.floor-cell.corridor {
  background: #fff7e8; border-color: #ffce8a; border-style: dashed; color: #8a5b16;
}
