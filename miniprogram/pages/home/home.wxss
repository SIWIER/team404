/* pages/home/home.wxss — 首页：物品数字化存放系统 */
.hero {
  background: linear-gradient(135deg, #3d7bfd, #6a5cff);
  color: #fff; padding: 48rpx 40rpx 56rpx; border-radius: 0 0 32rpx 32rpx;
  margin-bottom: 8rpx;
}
.hero-title { font-size: 44rpx; font-weight: 800; }
.hero-sub { font-size: 26rpx; opacity: 0.9; margin-top: 10rpx; }

/* 目录（家/公司/宿舍…）切换 */
.space-bar { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.space-title { font-size: 24rpx; font-weight: 700; color: #5a6b85; flex-shrink: 0; }
.space-scroll { white-space: nowrap; flex: 1; }
.space-chip {
  display: inline-block; padding: 8rpx 24rpx; margin-right: 12rpx;
  border: 1rpx solid #d8e2f5; border-radius: 999rpx;
  background: #fff; color: #1f2b3a; font-size: 24rpx; font-weight: 600;
}
.space-chip.on { background: #3d7bfd; border-color: #3d7bfd; color: #fff; }
.space-name { font-weight: 800; font-size: 28rpx; }

.layout-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; margin-bottom: 20rpx; }
.layout-head-l { flex: 1; }
.layout-title { font-weight: 800; font-size: 34rpx; }

/* 户型图预览（大格、显示房间名） */
.floor {
  display: flex; flex-direction: column; gap: 6rpx;
  padding: 16rpx; background: #fafcff; border: 2rpx dashed #d5ddeb; border-radius: 16rpx;
}
.floor-row { display: grid; gap: 6rpx; }
.floor-cell {
  border: 1rpx dashed #d5ddeb; border-radius: 8rpx; background: #fff;
  text-align: center; padding: 4rpx 2rpx;
  min-height: 64rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.floor-cell.empty { background: #f7f9fc; }
.floor-cell.corridor {
  background: #fff7e8; border-color: #ffce8a; border-style: dashed; color: #8a5b16;
}
.fc-emoji { font-size: 30rpx; line-height: 1.2; }
.fc-name { font-size: 18rpx; font-weight: 700; max-width: 100%; overflow: hidden; white-space: nowrap; }

.empty-layout {
  color: #7b8794; font-size: 26rpx; padding: 36rpx 20rpx; text-align: center;
  border: 2rpx dashed #d5ddeb; border-radius: 16rpx;
}
/* 整间搜完标记（所有格子一起变灰） */
.floor-cell.done { background: #eef0f3; border-color: #d7dbe1; color: #9aa3ad; opacity: .82; }
.floor-cell.done.corridor { background: #f2eee3; border-color: #e2d8bd; }
.fc-check { font-size: 16rpx; color: #1a7a4c; font-weight: 800; }
.fc-prog { font-size: 16rpx; color: #7b8794; font-weight: 700; }

/* 房间细致布局搜查浮层 */
.mask { position: fixed; inset: 0; z-index: 90; background: rgba(15, 23, 42, .45); display: flex; align-items: flex-end; }
.panel {
  background: #fff; border-radius: 28rpx 28rpx 0 0; width: 100%;
  padding: 32rpx 32rpx 48rpx; max-height: 82vh; overflow-y: auto;
}
.search-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }
.search-emoji { font-size: 60rpx; line-height: 1.1; }
.search-mid { flex: 1; min-width: 0; }
.search-name { font-weight: 800; font-size: 34rpx; }
.search-desc { font-size: 24rpx; margin-top: 4rpx; }
.furn-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin: 20rpx 0; }
.furn-item {
  border: 2rpx solid #e3e9f2; background: #fff; border-radius: 16rpx;
  padding: 18rpx 8rpx; display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  text-align: center; transition: all .15s ease;
}
.furn-item.searched { background: #eef0f3; border-color: #d7dbe1; color: #9aa3ad; opacity: .8; }
.furn-badge { font-size: 18rpx; font-weight: 800; padding: 4rpx 12rpx; border-radius: 999rpx; background: #eef1f6; color: #7b8794; }
.furn-item.searched .furn-badge { background: #dde3ea; color: #7a8694; }
.furn-emoji { font-size: 44rpx; line-height: 1.2; }
.furn-name { font-size: 22rpx; font-weight: 700; color: #3d4a5e; max-width: 100%; overflow: hidden; white-space: nowrap; }
.done-banner {
  display: flex; align-items: center; background: #e7f8ef; border: 2rpx solid #b9e6cf;
  color: #1a7a4c; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 24rpx; font-weight: 700; margin-bottom: 8rpx;
}
.search-bar { background: #f7f9fc; border-radius: 16rpx; padding: 20rpx; }
.search-last { margin-bottom: 8rpx; }
