<view wx:if="{{user}}">
  <view class="hero">
    <view class="hero-title">📦 物品数字化存放系统</view>
    <view class="hero-sub">你好，{{user.nickname}} · 为每件物品找到它的位置</view>
  </view>

  <!-- 当前目录户型图（首屏直观展示，房间格点击进入细致搜查） -->
  <view class="card">
    <view class="space-bar">
      <view class="space-title">🗂 目录</view>
      <scroll-view scroll-x class="space-scroll" wx:if="{{spaces.length > 1}}">
        <view class="space-chip {{activeSpaceId === item.id ? 'on' : ''}}" wx:for="{{spaces}}" wx:key="id"
              data-id="{{item.id}}" bindtap="switchSpace">{{item.name}}</view>
      </scroll-view>
      <view class="space-name" wx:else>{{activeSpaceName}}</view>
    </view>

    <view class="layout-head">
      <view class="layout-head-l">
        <view class="layout-title">🏠 {{activeSpaceName}} 户型图</view>
        <view class="muted" style="font-size:24rpx;margin-top:4rpx;">房间 {{layoutCount}} · 内部模块 {{furnCount}}{{searchText}}</view>
      </view>
      <view class="btn ghost sm" bindtap="goLayout">✏️ 编辑</view>
    </view>

    <block wx:if="{{placedCount}}">
      <view class="floor">
        <view class="floor-row" wx:for="{{floorRows}}" wx:for-item="row" wx:key="index" style="grid-template-columns: repeat({{row.cols}}, 1fr);">
          <view class="floor-cell {{item.empty ? 'empty' : ''}} {{item.corridor ? 'corridor' : ''}} {{item.done ? 'done' : ''}}"
                wx:for="{{row.cells}}" wx:for-item="item" wx:key="index"
                data-idx="{{item.roomIdx}}" bindtap="openRoom">
            <block wx:if="{{!item.empty}}">
              <view class="fc-emoji">{{item.e}}</view>
              <view class="fc-name" wx:if="{{item.n}}">{{item.n}}</view>
              <view class="fc-check" wx:if="{{item.done && item.first}}">✓ 已搜完</view>
              <view class="fc-prog" wx:elif="{{item.first && item.prog}}">{{item.prog}}</view>
            </block>
          </view>
        </view>
      </view>
      <view class="hint">点按房间格进入细致布局搜查，点按家具切换「已搜查」；搜完整间后户型图整间标记 ✓（进度仅保存在本机）</view>
    </block>
    <view wx:elif="{{layoutCount}}" class="empty-layout" bindtap="goLayout">房间都还没摆放，点这里去布置 ➜</view>
    <view wx:else class="empty-layout" bindtap="goLayout">还没有户型图，点这里开始搭建（把房间方块拖进网格即可）➜</view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-grid">
    <view class="menu-card" bindtap="go" data-url="items">
      <view class="badge">物品管理</view>
      <view class="ico">📦</view>
      <view class="t">物品管理</view>
      <view class="d">拍照录入 + 自动识别，文字/照片/描述三种方式检索，位置链直达户型图。</view>
    </view>
    <view class="menu-card" bindtap="go" data-url="layout">
      <view class="badge">户型配置</view>
      <view class="ico">🏠</view>
      <view class="t">户型图配置</view>
      <view class="d">目录管理、房间拖拽布置与内部模块（书桌/书架/壁橱…）。</view>
    </view>
    <view class="menu-card" bindtap="go" data-url="reason">
      <view class="badge">智能引导</view>
      <view class="ico">🔍</view>
      <view class="t">找物品引导</view>
      <view class="d">一问一答，AI 结合画像、户型与历史数据推理物品位置。</view>
    </view>
    <view class="menu-card" bindtap="go" data-url="data">
      <view class="badge">物品数据</view>
      <view class="ico">📊</view>
      <view class="t">数据统计与分析</view>
      <view class="d">存放记录、高频位置、房间热力、趋势图表与导入导出。</view>
    </view>
    <view class="menu-card" bindtap="go" data-url="hardware">
      <view class="badge">硬件端口</view>
      <view class="ico">📡</view>
      <view class="t">硬件设备接入</view>
      <view class="d">定位器 / 近场呼唤器 / 防丢标签，指令与实时事件流。</view>
    </view>
    <view class="menu-card" bindtap="go" data-url="profile">
      <view class="badge">个性化</view>
      <view class="ico">🧠</view>
      <view class="t">我的画像</view>
      <view class="d">生活习惯、常用位置、硬件设备与个人设置。</view>
    </view>
  </view>

  <view style="padding: 40rpx; text-align: center;">
    <view class="btn ghost" bindtap="logout">退出登录</view>
  </view>

  <!-- 房间细致布局搜查浮层 -->
  <view class="mask" wx:if="{{search.show}}" bindtap="closeSearch">
    <view class="panel" catchtap="noop">
      <view class="search-head">
        <view class="search-emoji">{{search.emoji}}</view>
        <view class="search-mid">
          <view class="search-name">{{search.name}}</view>
          <view class="muted search-desc">{{search.desc}}</view>
        </view>
        <view class="btn ghost sm" bindtap="closeSearch">✕ 关闭</view>
      </view>
      <view class="hint">点按家具切换「已搜查 / 未搜查」，已搜查会调灰并自动保存；搜完全部位置后，户型图中整间房间会标记 ✓。</view>
      <view class="furn-grid">
        <view class="furn-item {{item.on ? 'searched' : ''}}" wx:for="{{search.furn}}" wx:key="name"
              data-name="{{item.name}}" bindtap="toggleFurn">
          <view class="furn-badge">{{item.on ? '✓ 已搜查' : '未搜查'}}</view>
          <view class="furn-emoji">{{item.e}}</view>
          <view class="furn-name">{{item.name}}</view>
        </view>
      </view>
      <view class="done-banner" wx:if="{{search.done}}">🎉 本房间已全部搜完，户型图中已整间标记</view>
      <view class="search-bar">
        <view class="muted search-last">最后搜查：{{search.last || '尚未搜查任何家具'}}</view>
        <view class="btn-row">
          <button class="btn good" disabled="{{!search.searchedCount}}" bindtap="recordFound">🎯 找到了，记录最后搜查的家具</button>
          <button class="btn ghost" disabled="{{!search.searchedCount}}" bindtap="recordNotFound">📝 没找到，记录本次搜索</button>
        </view>
      </view>
    </view>
  </view>
</view>
