.center { text-align: center; }
.q-text { font-weight: 800; font-size: 32rpx; line-height: 1.5; margin-bottom: 24rpx; }

/* 策略入口卡片 */
.strategy-card {
  display: flex; align-items: center; gap: 24rpx;
  background: #fff; border-radius: 24rpx; padding: 32rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(40, 60, 110, 0.1);
}
.strategy-card:active { transform: scale(0.985); }
.s-ico { font-size: 56rpx; flex: none; }
.s-main { flex: 1; min-width: 0; }
.s-t { font-weight: 800; font-size: 32rpx; }
.s-d { color: #7b8794; font-size: 24rpx; line-height: 1.5; margin-top: 6rpx; }
.s-go { font-size: 44rpx; color: #b8c2cf; flex: none; }
.strategy-hint {
  margin: 8rpx 24rpx 40rpx; padding: 20rpx 24rpx; border-radius: 16rpx;
  background: #eaf1ff; color: #3d5b9e; font-size: 24rpx; line-height: 1.6;
}
