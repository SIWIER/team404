<view class="page-title">📷 拍照识别户型</view>
<view class="page-sub">上传一张户型图照片，自动识别房间并摆进网格，省去手动拖拽</view>

<!-- 未配置视觉模型：降级提示 -->
<view class="card notice" wx:if="{{!checking && !visionEnabled}}">
  <view class="notice-t">⚠️ 后端未配置视觉模型</view>
  <view class="hint">识别功能暂不可用（需在后端 .env 配置 LLM_VISION_* ）。你仍可在「户型图配置」页手动拖拽摆放户型，功能不受影响。</view>
  <view class="btn-row" style="justify-content:center;">
    <button class="btn ghost sm" bindtap="goLayout">→ 去手动编辑户型</button>
  </view>
</view>

<!-- 选图 -->
<view class="card">
  <view class="step-title">① 选择户型图</view>
  <view class="shot-tip">拍摄或从相册选择：光线均匀、图中文字清晰、尽量正对拍摄，识别更准</view>

  <view class="pick-box" wx:if="{{!imgPath}}" bindtap="chooseImage">
    <view class="pick-icon">🏠</view>
    <view class="pick-main">点击选择户型图</view>
    <view class="pick-sub">支持拍照 / 相册 · png、jpg、webp</view>
  </view>

  <view wx:else>
    <image class="preview-img" src="{{imgPath}}" mode="widthFix" bindtap="previewImage" />
    <view class="btn-row" style="justify-content:center;">
      <button class="btn ghost sm" disabled="{{recognizing || applying}}" bindtap="chooseImage">🔄 重新选图</button>
      <button class="btn ghost sm" disabled="{{recognizing || applying}}" bindtap="reset">🗑 清空</button>
    </view>
  </view>

  <view class="recognizing" wx:if="{{recognizing}}">
    <view class="spin">⏳</view>
    <view class="rec-main">正在识别户型…</view>
    <view class="hint">视觉模型分析中，通常需要 10-30 秒，请勿退出页面</view>
  </view>
</view>

<!-- 识别结果预览 -->
<view class="card" wx:if="{{tiles.length}}">
  <view class="step-title">② 确认识别结果</view>
  <view class="note-box" wx:if="{{note}}">🤖 {{note}}</view>

  <!-- 只读预览网格（样式与画像页编辑器一致） -->
  <view class="floor-area" style="width:{{grid.area}}px;height:{{grid.area}}px;">
    <view class="grid-cell" wx:for="{{grid.cells}}" wx:key="index"
          style="left:{{item.x}}px;top:{{item.y}}px;width:{{grid.cell}}px;height:{{grid.cell}}px;"></view>
    <view class="floor-tile {{item.corridor ? 'cor-seg' : ''}}" wx:for="{{tiles}}" wx:key="key"
          style="left:{{item.px}}px;top:{{item.py}}px;width:{{grid.cell}}px;height:{{grid.cell}}px;background:{{item.bg}};{{item.borderStyle}}">
      <view class="tile-emoji">{{item.emoji}}</view>
      <view class="tile-name">{{item.name}}</view>
    </view>
  </view>
  <view class="hint" style="text-align:center;">相邻格 = 相邻房间，会影响推理的「距离远近」权重</view>

  <!-- 房间清单 -->
  <view class="room-list">
    <view class="room-row" wx:for="{{rooms}}" wx:key="index">
      <text class="rr-emoji">{{item.emoji}}</text>
      <view class="rr-main">
        <view class="rr-name">{{item.name}}<text class="rr-badge" wx:if="{{item.cellCount > 1}}">{{item.cellCount}} 格</text></view>
        <view class="rr-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="hint">识别结果可能有偏差，应用后可在「户型图配置」页手动拖拽调整每个房间的位置。</view>
  <button class="btn btn-block" loading="{{applying}}" disabled="{{applying}}" bindtap="applyLayout">✅ 应用到我的户型图</button>
</view>

<view class="privacy-note">🔒 照片仅用于本次识别：上传的图片只在内存中转发给识别模型，不会保存到服务器，也不会存进数据库。</view>

<view style="padding: 16rpx 32rpx 60rpx; text-align: center;">
  <button class="btn ghost" bindtap="goLayout">← 返回户型图配置</button>
</view>
