<view class="page-title">🧠 我的存放偏好</view>
<view class="page-sub">偏好越准确，找物品的推理越贴合你的习惯；户型图请到「户型图配置」页管理</view>

<!-- 户型图配置入口（已独立成页） -->
<view class="card layout-link" bindtap="goLayout">
  <view class="ll-ico">🏠</view>
  <view class="ll-main">
    <view class="ll-t">户型图配置</view>
    <view class="ll-d">目录管理、房间拖拽布置、内部模块（书桌/书架/壁橱…）已独立到单独页面</view>
  </view>
  <view class="ll-go">›</view>
</view>

<!-- 基础画像表单 -->
<view class="card">
  <view class="field">
    <label>助手昵称</label>
    <input class="input" value="{{agentName}}" data-k="agentName" bindinput="onInput" placeholder="例如：我的收纳助手" />
  </view>
  <view class="field">
    <label>助手风格</label>
    <input class="input" value="{{agentStyle}}" data-k="agentStyle" bindinput="onInput" placeholder="例如：温和、爱追问、擅长收纳常识" />
  </view>
  <view class="field">
    <label>收纳习惯（每行一条，最多 20 条）</label>
    <textarea class="input area" value="{{habitsText}}" data-k="habitsText" bindinput="onInput" placeholder="例如：睡前刷手机后常随手把物品放床头" />
  </view>
  <view class="field">
    <label>常用存放位置（每行一条，最多 20 条）</label>
    <textarea class="input area-s" value="{{favsText}}" data-k="favsText" bindinput="onInput" placeholder="例如：床头柜、书桌抽屉" />
  </view>
  <view class="field">
    <label>备注（物品情况等）</label>
    <textarea class="input area-s" value="{{notes}}" data-k="notes" bindinput="onInput" />
  </view>
  <view class="field">
    <label>我的硬件设备（没有可不选；无硬件时推理会强化行为与历史证据）</label>
    <view class="hw-opt {{hwPicks.uhf_reader ? 'on' : ''}}" data-key="uhf_reader" bindtap="toggleHw">🎛️ UHF 手持机（RFID 读取器）{{hwPicks.uhf_reader ? ' ✓' : ''}}</view>
    <view class="hw-opt {{hwPicks.case_locator ? 'on' : ''}}" data-key="case_locator" bindtap="toggleHw">📡 物品盒定位器{{hwPicks.case_locator ? ' ✓' : ''}}</view>
  </view>
  <view class="field">
    <label>已接入设备（与硬件页实时同步）</label>
    <view class="dev-chip-list" wx:if="{{devices.length}}">
      <view class="dev-chip {{item.on ? 'on' : ''}}" wx:for="{{devices}}" wx:key="id">
        {{item.icon}} {{item.name}} · {{item.label}} · {{item.on ? '在线' : '离线'}}<text wx:if="{{item.isMock}}">（模拟）</text>
      </view>
    </view>
    <view class="hint" wx:if="{{deviceHint}}">{{deviceHint}}</view>
    <view class="hint" wx:elif="{{!devices.length}}">上方勾选硬件类型后，这里会显示对应的已接入设备；没有设备也不影响使用。</view>
    <view class="btn ghost sm" style="margin-top:16rpx;" bindtap="goHardware">📡 去硬件页管理设备</view>
  </view>
  <button class="btn btn-block" loading="{{saving}}" disabled="{{saving}}" bindtap="saveBasic">💾 保存偏好</button>
</view>

<view class="privacy-note">🔒 数据仅用于本地推理：你的偏好、户型与物品记录只保存在你自己的账号下，不会公开或用于其他用途。</view>

<view style="padding: 16rpx 32rpx 60rpx; text-align: center;">
  <button class="btn ghost" bindtap="goHome">← 返回首页</button>
</view>

<!-- 注销账号（删除全部个人数据，需双重确认） -->
<view style="padding: 0 32rpx 240rpx; text-align: center;">
  <button class="btn warn sm" bindtap="deleteAccount">⚠️ 注销账号（删除全部个人数据）</button>
</view>