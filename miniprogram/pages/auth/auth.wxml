<view class="auth-wrap">
  <view class="logo">👓</view>
  <view class="title">找眼镜助手</view>
  <view class="sub">在家里没戴眼镜，也能帮你把眼镜找回来</view>

  <view class="card">
    <view class="tabs">
      <view class="tab {{tab === 'login' ? 'on' : ''}}" bindtap="setTab" data-tab="login">登录</view>
      <view class="tab {{tab === 'reg' ? 'on' : ''}}" bindtap="setTab" data-tab="reg">注册</view>
    </view>

    <block wx:if="{{tab === 'login'}}">
      <view class="field">
        <label>用户名</label>
        <input class="input" placeholder="如 xiaoming" value="{{username}}" data-k="username" bindinput="onInput" />
      </view>
      <view class="field">
        <label>密码</label>
        <input class="input" password placeholder="123456" value="{{password}}" data-k="password" bindinput="onInput" />
      </view>
      <view class="remember">
        <switch checked="{{remember}}" bindchange="toggleRemember" color="#3d7bfd" style="transform:scale(.8);" />
        <text>记住我（30 天免登录）</text>
      </view>
    </block>

    <block wx:else>
      <view class="field">
        <label>用户名</label>
        <input class="input" placeholder="2-24 位，字母/数字/中文" value="{{username}}" data-k="username" bindinput="onInput" />
      </view>
      <view class="field">
        <label>昵称</label>
        <input class="input" placeholder="怎么称呼你" value="{{nickname}}" data-k="nickname" bindinput="onInput" />
      </view>
      <view class="field">
        <label>密码</label>
        <input class="input" password placeholder="至少 4 位" value="{{password}}" data-k="password" bindinput="onInput" />
      </view>
      <view class="field">
        <label>确认密码</label>
        <input class="input" password placeholder="再输入一次" value="{{password2}}" data-k="password2" bindinput="onInput" />
      </view>
    </block>

    <view class="err-msg" wx:if="{{error}}">{{error}}</view>
    <button class="btn btn-main" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">
      {{tab === 'login' ? '登 录' : '注 册'}}
    </button>
  </view>

  <!-- 微信一键登录（登录页主流程下） -->
  <view class="card wx-card" wx:if="{{tab === 'login'}}">
    <view class="divider"><text class="line"></text><text class="txt">其他登录方式</text><text class="line"></text></view>
    <button
      class="btn btn-wx {{wxEnabled ? '' : 'disabled'}}"
      loading="{{wxBusy}}"
      disabled="{{wxBusy || !wxEnabled}}"
      bindtap="onWxLogin"
      hover-class="{{wxEnabled ? 'btn-wx-hover' : 'none'}}"
    >
      <text class="wx-ico">💬</text>
      <text>{{wxBusy ? '登录中…' : '微信一键登录'}}</text>
    </button>
    <view class="wx-hint" wx:if="{{!wxEnabled}}">{{wxConfigHint || '微信登录暂未启用'}}</view>
  </view>

  <view class="demo-tip">演示账号：xiaoming / 123456 ｜ xiaohong / 123456</view>

  <!-- 初次注册后的"有无硬件设备"提问（默认无设备：问答推理不依赖硬件） -->
  <view class="card device-card" wx:if="{{deviceAsk}}">
    <view class="device-title">🎉 注册成功！你有以下硬件设备吗？</view>
    <view class="device-sub">没有也没关系：问答式推理不依赖任何硬件。选"有"可让设备信号辅助定位。</view>
    <view class="device-opt {{devicePicks.uhf_reader ? 'on' : ''}}" data-key="uhf_reader" bindtap="toggleDevicePick">
      <view class="opt-ico">📡</view>
      <view class="opt-main">
        <view class="opt-name">UHF 手持机（RFID 读取器）</view>
        <view class="opt-desc">配合贴在眼镜上的无源电子标签，扫房间找眼镜</view>
      </view>
      <view class="opt-check">{{devicePicks.uhf_reader ? '✓' : ''}}</view>
    </view>
    <view class="device-opt {{devicePicks.case_locator ? 'on' : ''}}" data-key="case_locator" bindtap="toggleDevicePick">
      <view class="opt-ico">🎒</view>
      <view class="opt-main">
        <view class="opt-name">眼镜盒定位器</view>
        <view class="opt-desc">装在眼镜盒上，找"盒子+眼镜"一起丢的情况，可远程蜂鸣</view>
      </view>
      <view class="opt-check">{{devicePicks.case_locator ? '✓' : ''}}</view>
    </view>
    <view class="btn-row">
      <button class="btn btn-ghost" bindtap="skipDevice" disabled="{{deviceBusy}}">都没有，跳过</button>
      <button class="btn btn-main" bindtap="confirmDevice" loading="{{deviceBusy}}" disabled="{{deviceBusy}}">完成</button>
    </view>
  </view>

  <!-- 绑定已有账号 弹窗 -->
  <view class="bind-mask" wx:if="{{bindShow}}" bindtap="closeBind">
    <view class="bind-dialog" catchtap="">
      <view class="bind-title">绑定已有账号</view>
      <view class="bind-sub">该微信尚未绑定任何账号，请输入您在本应用的用户名与密码完成绑定</view>
      <view class="field">
        <label>用户名</label>
        <input class="input" placeholder="如 xiaoming" value="{{bindUsername}}" data-k="bindUsername" bindinput="onBindInput" />
      </view>
      <view class="field">
        <label>密码</label>
        <input class="input" password placeholder="密码" value="{{bindPassword}}" data-k="bindPassword" bindinput="onBindInput" />
      </view>
      <view class="err-msg" wx:if="{{bindError}}">{{bindError}}</view>
      <view class="btn-row">
        <button class="btn btn-ghost" bindtap="closeBind" disabled="{{bindBusy}}">取 消</button>
        <button class="btn btn-main" bindtap="confirmBind" loading="{{bindBusy}}" disabled="{{bindBusy}}">绑 定 并 登 录</button>
      </view>
    </view>
  </view>
</view>
