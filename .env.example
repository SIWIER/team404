# 复制本文件为 .env 后按需修改（也可直接用环境变量）
PORT=8081
DB_FILE=data/find_glasses.db
# 会话令牌签名密钥（生产环境务必改成随机长字符串）
TOKEN_SECRET=change-me-to-a-long-random-secret
# 会话有效期（小时）
TOKEN_TTL_HOURS=24
TOKEN_TTL_HOURS_REMEMBER=720
# 大模型（OpenAI 兼容 / DeepSeek）——文本推理用
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=25000
# 视觉模型（OpenAI 兼容的多模态接口）——户型图照片识别用
# 注意：deepseek-chat 是纯文本模型，不能读图，所以这里要单独配一个支持视觉的模型
# 三项（BASE_URL / API_KEY / MODEL）留空则该功能自动降级：
#   接口返回 503，小程序识别按钮置灰，手动拖拽户型完全不受影响
# Key 属于个人，只填在本地 .env，绝不提交
LLM_VISION_ENABLED=true
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=
LLM_VISION_TIMEOUT_MS=40000
# 硬件模拟器（演示用；真实设备接入时可关闭）
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=8000
