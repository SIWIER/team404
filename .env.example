# 复制本文件为 .env 后按需修改（也可直接用环境变量）
PORT=8081
DB_FILE=data/find_glasses.db
# 会话令牌签名密钥（生产环境务必改成随机长字符串）
TOKEN_SECRET=change-me-to-a-long-random-secret
# 会话有效期（小时）
TOKEN_TTL_HOURS=24
TOKEN_TTL_HOURS_REMEMBER=720
# 大模型（OpenAI 兼容 / DeepSeek）——文本推理用
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=25000
# 视觉模型（OpenAI 兼容的多模态接口）——户型图照片识别用
# 注意：deepseek-chat 是纯文本模型，不能读图，所以这里要单独配一个支持视觉的模型
# 三项（BASE_URL / API_KEY / MODEL）留空则该功能自动降级：
#   接口返回 503，小程序识别按钮置灰，手动拖拽户型完全不受影响
# Key 属于个人，只填在本地 .env，绝不提交
#
# MODEL 怎么选（用同一张测试户型图实测过，结论供参考）：
#   ✅ gpt-4o           房间齐全、走廊多格链正确，约 4s，推荐
#   ⚠️ gpt-4o-mini      会漏掉走廊，只认出 4 个房间，不建议
#   ❌ deepseek-*       推理型模型把 token 全花在思维链上，content 返回空，识别必失败
# 换服务商时先确认模型支持 image_url 多模态输入，再填这里。
LLM_VISION_ENABLED=true
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=
LLM_VISION_TIMEOUT_MS=40000
# 硬件模拟器（演示用；真实设备接入时可关闭）
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=8000
# 微信登录（小程序版 wx.login 一键登录与绑定）
# 申请地址：https://mp.weixin.qq.com → 开发管理 → 开发设置
# 注意：Secret 一旦泄露请立即在微信后台重置；本文件务必 .gitignore
WX_APPID=
WX_SECRET=
# 未绑定 openid 的微信用户首次登录时是否自动建号（默认 true：开箱即用）
# 设为 false 时，未绑定用户将拿到一次性 bindToken，需在登录页填写已有账号密码完成绑定
WX_AUTO_REGISTER=true
# 测试/开发用：设置一个非空值后，/api/auth/wxlogin 的 code2session 直接返回该 openid，
# 不真实调微信接口（CI 与本地无 AppID 时使用）
WX_MOCK_OPENID=
