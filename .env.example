# 复制本文件为 .env 后按需修改（也可直接用环境变量）
PORT=8081
DB_FILE=data/find_glasses.db
# 会话令牌签名密钥（生产环境务必改成随机长字符串）
TOKEN_SECRET=change-me-to-a-long-random-secret
# 会话有效期（小时）
TOKEN_TTL_HOURS=24
TOKEN_TTL_HOURS_REMEMBER=720
# 大模型（OpenAI 兼容 / DeepSeek）
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=25000
# 硬件模拟器（演示用；真实设备接入时可关闭）
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=8000
